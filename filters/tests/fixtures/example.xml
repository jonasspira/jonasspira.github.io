  </entry>
  <entry>
    <category term='filter'/><title>Mail Filter</title><content/>
    <apps:property name='from' value='billing@example.com OR offers@example.net'/>
    <apps:property name='shouldTrash' value='true'/>
    <apps:property name='sizeOperator' value='s_sl'/><apps:property name='sizeUnit' value='s_smb'/>
  </entry>
  <entry>
    <category term='filter'/><title>Mail Filter</title><content/>
    <apps:property name='from' value='&quot; noreply@notify.example.org&quot;'/>
    <apps:property name='hasTheWord' value='&quot;track your order&quot;'/>
    <apps:property name='label' value='Orders'/>
    <apps:property name='sizeOperator' value='s_sl'/><apps:property name='sizeUnit' value='s_smb'/>
  </entry>
  <entry>
