  <entry>
    <category term='filter'/><title>Mail Filter</title><content/>
    <apps:property name='from' value='files@example.org'/>
    <apps:property name='doesNotHaveTheWord' value='&quot;O&apos;Brien&quot; &lt;internal&gt;'/>
    <apps:property name='hasAttachment' value='true'/><apps:property name='excludeChats' value='true'/>
    <apps:property name='size' value='2'/><apps:property name='sizeOperator' value='s_ss'/><apps:property name='sizeUnit' value='s_smb'/>
    <apps:property name='label' value='Files'/><apps:property name='forwardTo' value='archive@example.org'/>
