<?xml version='1.0' encoding='UTF-8'?>
<feed xmlns='http://www.w3.org/2005/Atom' xmlns:apps='http://schemas.google.com/apps/2006'>
  <title>Mail Filters</title>
  <entry>
    <category term='filter'/><title>Mail Filter</title><content/>
    <apps:property name='from' value='billing@example.com'/>
    <apps:property name='subject' value='&quot;Terms &amp; Conditions&quot;'/>
    <apps:property name='label' value='Bills &amp; receipts'/>
    <apps:property name='shouldStar' value='true'/>
    <apps:property name='sizeOperator' value='s_sl'/><apps:property name='sizeUnit' value='s_smb'/>
  </entry>
  <entry>
    <category term='filter'/><title>Mail Filter</title><content/>
    <apps:property name='from' value='billing@example.com'/>
    <apps:property name='subject' value='&quot;Terms &amp; Conditions&quot;'/>
    <apps:property name='label' value='Bills &amp; receipts'/>
    <apps:property name='shouldStar' value='true'/>
