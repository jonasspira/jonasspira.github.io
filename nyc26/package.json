{
  "name": "nyc26",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node sync.mjs",
    "api": "wrangler dev --config worker/wrangler.toml --local --persist-to .wrangler/state --port 8787",
    "db:init": "wrangler d1 execute nyc26 --local --persist-to .wrangler/state --file worker/schema.sql",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
